<section id="signup-form" hidden>
  <h2>Sign up</h2>
  <p id="signup-class-label"></p>

  <label>Name
    <input id="signup-name" type="text" maxlength="100" autocomplete="name" />
  </label>

  <label>Phone number
    <input id="signup-phone" type="tel" autocomplete="tel" placeholder="040 123 4567" />
  </label>

  <label>
    <input id="signup-consent" type="checkbox" />
    I agree that my name and number are used to add me to Afrofit whatsApp group. They are deleted after the class.
  </label>

  <p id="signup-error" hidden></p>

  <button id="signup-confirm-btn" type="button">Confirm</button>
  <button id="signup-cancel-btn" type="button">Cancel</button>
</section>

<p id="signup-success" hidden></p>
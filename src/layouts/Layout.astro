---
import "../styles/global.css";

interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = "Afrofit Oulu", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<html lang="en">
   <h1>Afrofit</h1>

   <script>
     import { supabase } from "../lib/supabase";

     const { data, error } = await supabase
       .from("classes")
       .select("*")
       .gt("starts", new Date().toISOString())
       .order("starts")
       .limit(1);

     console.log({ data, error });
   </script>
</html>
